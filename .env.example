NEXT_PUBLIC_PB_URL=http://127.0.0.1:8090
PB_ADMIN_EMAIL=owner@example.com
PB_ADMIN_PASSWORD=change-me
# Optional: app members who can manage feedback and other admin-only screens.
CLUB_ADMIN_EMAILS=
CREW_INVITE_CODE=change-this-before-production
SERVER_ACTION_ALLOWED_ORIGINS=localhost:3000
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional: set when proxy/origin inference does not match your Google OAuth redirect URI.
# GOOGLE_OAUTH_REDIRECT_URI=https://example.com/api/auth/google/callback
# Optional: force auth cookies secure/insecure. Leave unset for auto.
# AUTH_COOKIE_SECURE=false
# Optional feedback-to-GitHub integration. Prefer the GitHub App values.
# GITHUB_FEEDBACK_REPOSITORY=owner/repo
# GITHUB_APP_ID=
# GITHUB_APP_INSTALLATION_ID=
# GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Optional fallback for local testing with a fine-grained issues:write token.
# GITHUB_FEEDBACK_TOKEN=
# Optional webhook synchronization.
# GITHUB_WEBHOOK_SECRET=
